{
  "name": "devable/rectorphp-junit",
  "description": "Restores JUnit XML output (--output-format=junit) to Rector 2.x, removed upstream in rectorphp/rector-src PR #8250",
  "type": "library",
  "license": "MPL-2.0",
  "authors": [
    {
      "name": "Jan Matthiesen",
      "homepage": "https://devable.me",
      "role": "Manufacturer"
    }
  ],
  "keywords": [
    "rector",
    "junit",
    "ci",
    "output-format"
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.1",
    "ext-dom": "*",
    "rector/rector": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Devable\\RectorphpJunit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Devable\\RectorphpJunit\\Tests\\": "tests/"
    }
  }
}
